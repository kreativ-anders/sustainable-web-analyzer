#!/usr/bin/env php
<?php

declare(strict_types=1);

// Regenerates data/grid-intensity.php from Our World in Data: the latest yearly value per country.
// Needs the intl extension (ICU maps the ISO 3166-1 alpha-3 codes of OWID to alpha-2).

if (PHP_SAPI !== 'cli') {
    exit(1);
}

const SOURCE_URL = 'https://raw.githubusercontent.com/owid/energy-data/master/owid-energy-data.csv';

$csv = fopen(SOURCE_URL, 'r') ?: exit("Cannot download " . SOURCE_URL . "\n");
$header = fgetcsv($csv, escape: '');

$latest = []; // alpha-3 => [year, value]
while (($row = fgetcsv($csv, escape: '')) !== false) {
    $row = array_combine($header, $row);
    $year = (int) $row['year'];
    // Aggregates such as "World" or "OWID_KOS" have no three-letter ISO code
    if (strlen($row['iso_code']) === 3 && $row['carbon_intensity_elec'] !== '' && $year >= ($latest[$row['iso_code']][0] ?? 0)) {
        $latest[$row['iso_code']] = [$year, (int) round((float) $row['carbon_intensity_elec'])];
    }
}

$territories = ResourceBundle::create('metadata', 'ICUDATA', false)['alias']['territory'];
$countries = [];
foreach ($latest as $code => [, $value]) {
    $alpha2 = $territories[$code]['replacement'] ?? '';
    if (strlen($alpha2) === 2) {
        $countries[$alpha2] = $value;
    } else {
        fwrite(STDERR, "Skipped {$code}: no ISO alpha-2 code\n");
    }
}
ksort($countries);

$php = "<?php\n\n"
    . "// Yearly grid carbon intensity per country (latest year available), in g CO2e/kWh, ISO 3166-1 alpha-2 => value.\n"
    . "//\n"
    . "// Source: Our World in Data, based on Ember and the Energy Institute, https://github.com/owid/energy-data\n"
    . "// License: CC BY 4.0, https://creativecommons.org/licenses/by/4.0/\n"
    . "// Generated by bin/update-grid-intensity, do not edit by hand.\n\n"
    . "return [\n";
foreach ($countries as $code => $value) {
    $php .= "    '{$code}' => {$value},\n";
}
file_put_contents(dirname(__DIR__) . '/data/grid-intensity.php', $php . "];\n");

echo count($countries), " countries written\n";
